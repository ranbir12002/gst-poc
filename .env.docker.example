# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values before deploying. docker compose reads ".env" automatically.

# Mongo container root credentials (used to build MONGO_URI for the app too)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_to_a_strong_password

# nginx's host-published port. Defaults to 80; override if that's already
# taken by something else on the machine (e.g. another project's stack).
HTTP_PORT=80

# Optional: only needed if the frontend is served from a different origin
# than the backend/nginx. Leave blank for the normal single-container setup.
# (Maps use maplibre-gl + OpenStreetMap tiles, so no Mapbox token needed.)
REACT_APP_BACKEND_URL=
REACT_APP_GEOJSON_URL=
