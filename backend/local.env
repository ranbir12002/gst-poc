# Real values for the plain Node.js + MongoDB (non-Docker) deployment.
# deploy-windows.ps1 copies this to backend/.env automatically if
# backend/.env doesn't exist yet, so a fresh clone works with zero manual
# secret setup.
#
# JWT_SECRET is the same one currently running in the Docker deployment on
# the dev machine (kept identical on purpose, per instruction to reuse it).
#
# MONGO_URI below assumes a plain local MongoDB install with no auth
# configured (the default). If instead you set up MongoDB with the same
# admin user/password as the Docker deployment, use the commented line
# instead.
MONGO_URI=mongodb://localhost:27017/stateGst
# MONGO_URI=mongodb://admin:gKdLCReW3RymYBNqoYylcBWtcS4gTqu@localhost:27017/stateGst?authSource=admin

JWT_SECRET=P7MaKYj2gArxAEgTxI9R2IdZQ5+5CmQKNZs2l3PKJ5iwK8WTMWTx5idFqPMvc8gW
PORT=5000
